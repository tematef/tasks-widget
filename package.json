{
  "name": "tasks-runner",
  "displayName": "Task Runner",
  "description": "IntelliJ IDEA-style Run Configuration and Task Dropdown widget in the VS Code status bar and Activity Bar",
  "version": "0.0.2",
  "publisher": "tasks-runner",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tematef/tasks-widget.git"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:tasksWidget.sidebarView",
    "onCommand:tasksWidget.selectTask",
    "onCommand:tasksWidget.runSelectedTask",
    "onCommand:tasksWidget.stopSelectedTask",
    "onCommand:tasksWidget.debugSelectedTask",
    "onCommand:tasksWidget.addNewTask",
    "onCommand:tasksWidget.editTask",
    "onCommand:tasksWidget.configureTasks",
    "onCommand:tasksWidget.refreshTasks",
    "onCommand:tasksWidget.runTreeTask",
    "onCommand:tasksWidget.debugTreeTask",
    "onCommand:tasksWidget.editTreeTask",
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tasksWidget.selectTask",
        "title": "Select Task",
        "category": "Tasks Widget"
      },
      {
        "command": "tasksWidget.runSelectedTask",
        "title": "Run Selected Task",
        "category": "Tasks Widget",
        "icon": "$(play)"
      },
      {
        "command": "tasksWidget.stopSelectedTask",
        "title": "Stop Selected Task",
        "category": "Tasks Widget",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tasksWidget.debugSelectedTask",
        "title": "Debug Selected Task",
        "category": "Tasks Widget",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tasksWidget.addNewTask",
        "title": "Add New Task",
        "category": "Tasks Widget",
        "icon": "$(add)"
      },
      {
        "command": "tasksWidget.editTask",
        "title": "Edit Task in tasks.json",
        "category": "Tasks Widget",
        "icon": "$(edit)"
      },
      {
        "command": "tasksWidget.configureTasks",
        "title": "Configure tasks.json",
        "category": "Tasks Widget",
        "icon": "$(gear)"
      },
      {
        "command": "tasksWidget.refreshTasks",
        "title": "Refresh Tasks",
        "category": "Tasks Widget",
        "icon": "$(refresh)"
      },
      {
        "command": "tasksWidget.runTreeTask",
        "title": "Run Task",
        "category": "Tasks Widget",
        "icon": "$(play)"
      },
      {
        "command": "tasksWidget.debugTreeTask",
        "title": "Debug Task",
        "category": "Tasks Widget",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tasksWidget.editTreeTask",
        "title": "Edit Task in tasks.json",
        "category": "Tasks Widget",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tasks-widget-view-container",
          "title": "Tasks Runner",
          "icon": "resources/tasks-icon.svg"
        }
      ]
    },
    "views": {
      "tasks-widget-view-container": [
        {
          "id": "tasksWidget.sidebarView",
          "name": "Tasks Runner",
          "when": "config.taskRunner.showActivityBarView"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tasksWidget.runSelectedTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "tasksWidget.debugSelectedTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "tasksWidget.stopSelectedTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "tasksWidget.addNewTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "navigation@4"
        },
        {
          "command": "tasksWidget.refreshTasks",
          "when": "view == tasksWidget.sidebarView",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "tasksWidget.runTreeTask",
          "when": "view == tasksWidget.sidebarView && viewItem == idleTaskItem",
          "group": "inline@1"
        },
        {
          "command": "tasksWidget.stopSelectedTask",
          "when": "view == tasksWidget.sidebarView && viewItem == runningTaskItem",
          "group": "inline@1"
        },
        {
          "command": "tasksWidget.debugTreeTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "inline@2"
        },
        {
          "command": "tasksWidget.editTreeTask",
          "when": "view == tasksWidget.sidebarView",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "Task Runner",
      "properties": {
        "taskRunner.showStatusBarWidget": {
          "type": "boolean",
          "default": true,
          "description": "Show the task dropdown selector and run/stop/debug controls in the status bar."
        },
        "taskRunner.showActivityBarView": {
          "type": "boolean",
          "default": true,
          "description": "Show the dedicated Tasks Runner icon and view in the Activity Bar."
        },
        "taskRunner.showDebugButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the debug button next to the play button in the status bar."
        },
        "taskRunner.statusBarPriority": {
          "type": "number",
          "default": 100,
          "description": "Priority order of the task dropdown in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npx @vscode/vsce package --allow-star-activation",
    "build:vsix": "npx @vscode/vsce package --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
